{
  "name": "@agentix-e/db-cluster",
  "version": "1.1.0",
  "description": "Database cluster orchestration layer with consensus, WAL, sharding, and HA",
  "type": "module",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "dead": "knip",
    "clean": "rm -rf dist",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "bench": "tsx bench/run-all.ts",
    "bench:ycsb": "tsx bench/ycsb/run-ycsb.ts",
    "tla-check": "bash tla/tla-check.sh",
    "docs": "typedoc",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "coverage": "vitest run --coverage",
    "ci": "npm run format:check && npx tsc --noEmit && npm run test && npm run coverage"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "database",
    "cluster",
    "raft",
    "sharding",
    "high-availability"
  ],
  "license": "MIT",
  "dependencies": {
    "@maboke123/raft-core": "^0.2.1",
    "@mongodb-js/zstd": "^7.0.0",
    "@msgpack/msgpack": "^3.1.3",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.11.1",
    "buffer-crc32": "^1.0.0",
    "node-forge": "^1.4.3",
    "opossum": "^10.0.0",
    "pino": "^9.0.0",
    "tla-checker": "^0.6.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.6.0",
    "knip": "^6.25.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentiX-E/db-cluster.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./raft": {
      "types": "./dist/consensus/core/RaftAdapter.d.ts",
      "require": "./dist/consensus/core/RaftAdapter.js"
    },
    "./shard": {
      "types": "./dist/interfaces/shard/index.d.ts",
      "require": "./dist/interfaces/shard/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "require": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "optionalDependencies": {
    "pg": "^8.23.0"
  }
}
