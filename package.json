{
  "name": "@agentix-e/db-cluster",
  "version": "0.0.0",
  "description": "Database cluster orchestration layer with consensus, WAL, sharding, and HA",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "dead": "knip",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "database",
    "cluster",
    "raft",
    "sharding",
    "high-availability"
  ],
  "license": "MIT",
  "dependencies": {
    "@maboke123/raft-core": "^0.2.1",
    "@mongodb-js/zstd": "^7.0.0",
    "@msgpack/msgpack": "^3.1.3",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.11.1",
    "buffer-crc32": "^1.0.0",
    "node-forge": "^1.4.0",
    "opossum": "^10.0.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.0",
    "eslint": "^10.6.0",
    "knip": "^6.25.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.0.0"
  }
}
